;:ts=8

; jd 8/28/91 new
; BuildEasyRequest is in amiga.lib, not intuition.library
	xref	_IntuitionBase
	xdef	_BuildEasyRequest
_BuildEasyRequest:
	movem.l	a3/a6,-(sp)
	move.l	_IntuitionBase,a6
	lea	12(sp),a3
	movem.l	(a3)+,a0-a1
	move.l	(a3)+,d0
	jsr	-594(a6)		;BuildEasyRequestArgs
	movem.l	(sp)+,a3/a6
	rts
