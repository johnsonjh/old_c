;:ts=8

; jd 8/28/91 new. 
; GT_SetGadgetAttrs is glue only, not an entry in gadtools.library
	xref	_GadToolsBase
	xdef	_GT_SetGadgetAttrs
_GT_SetGadgetAttrs:
	movem.l	a6/a2/a3,-(sp)
	move.l	_GadToolsBase,a6
	lea	16(sp),a3
	movem.l	(a3)+,a0-a2
	jsr	-42(a6)			;GT_SetGadgetAttrsA
	movem.l	(sp)+,a6/a2/a3
	rts
