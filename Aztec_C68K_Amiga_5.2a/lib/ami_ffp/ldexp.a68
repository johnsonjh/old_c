; :ts=8
; for ffp, compiler outputs 8 bytes for double args, even though doubles
; are actually only 4 bytes. if the compiler is changed to fix this,
; the following equate must be changed to 8:
INTOFF	equ	12
ERANGE	equ	13
EDOM	equ	14
;
	xdef	_errno
;
;	double ldexp(double d, int i)
;
;	return x = d * 2^i
;
	public	_ldexp
_ldexp	
	move.l	4(sp),d0	;get d in d0
	sub.l	d1,d1		;get new exponent in d1
	move.b	d0,d1
	and.b	#$7f,d1		;turn off sign bit
	if	INT32
	add.l	INTOFF(sp),d1	;add i to d's exponent
	else
	add.w	INTOFF(sp),d1
	endc
	cmp.l	#$7f,d1		;new exp too big?
	bhi	over		;br if yes
	tst.l	d1		;too low?
	bmi	under		;br if yes
	and.b	#$80,d0		;move new exp into d0
	or.b	d1,d0
	rts

over:
	if	INT32
	move.l	#ERANGE,_errno
	else
	move.w	#ERANGE,_errno
	endc
	move.l	#$ffffff7f,d0	;return HUGE_VAL
	rts


under:
	if	INT32
	move.l	#ERANGE,_errno
	else
	move.w	#ERANGE,_errno
	endc
	sub.l	d0,d0		;return 0
	rts


