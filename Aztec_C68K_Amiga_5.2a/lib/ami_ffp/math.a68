	public	amiga_math
amiga_math:
	tst.l	_MathTransBase
	bne	skip
	movem.l	d0-d3/a0/a1/a6,-(sp)
	move.l	_SysBase,a6
	move.l	#0,d0
	lea	libnam,a1
	jsr	-552(a6)	;OpenLibrary
	move.l	d0,_MathTransBase
