	move.l	a0,d2
	move.l	#23,d3
	jsr	-48(a6)		;Write
	move.l	#1,-(sp)
	jsr	__abort
done
	movem.l	(sp)+,d0-d3/a0/a1/a6
skip
	move.w	(sp)+,a0
	move.l	4(sp),d0
	move.l	12(sp),d1
	move.l	a6,-(sp)
	move.l	_MathTransBase,a6
